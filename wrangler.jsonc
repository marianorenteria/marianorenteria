{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marianorenteria",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    // Astro writes each page as a folder index (links/index.html, blog/index.html).
    // /links redirects to /links/ and that file is served. Same for /blog and the rest.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Workers Builds runs `wrangler preview` on non-production branches.
  // That command refuses to start unless this block exists. It can be empty.
  "previews": {}
}
