---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Signup from "../../components/Signup.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---
<SiteLayout
  title="Blog y newsletter — Mariano Rentería"
  description="Posts de Mariano Rentería sobre carrera, liderazgo y tecnología. El blog y el newsletter son lo mismo."
>
  <section class="page-hero wrap">
    <span class="kicker">Blog y newsletter</span>
    <h1>Lo que voy escribiendo</h1>
    <p>El blog y el newsletter son lo mismo: carrera, liderazgo y tecnología. Lo que publico aquí también te puede llegar por email. Estos posts se publicaron primero en DEV Community; aquí están completos.</p>
  </section>

  <section class="band" style="padding-top:12px;">
    <div class="wrap">
      <div class="grid-posts">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <p style="margin:28px 0 0;color:var(--muted);">
        <a class="text-link" href="https://dev.to/marianorenteria" target="_blank" rel="noopener">Ver el archivo completo en DEV.to →</a>
      </p>
      <Signup
        anchor
        extraClass="mt"
        text="El blog y el newsletter son lo mismo: carrera, liderazgo y tecnología, de vez en cuando, sin spam."
      />
    </div>
  </section>
</SiteLayout>
