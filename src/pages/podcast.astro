---
import SiteLayout from "../layouts/SiteLayout.astro";
import PodcastPromo from "../components/PodcastPromo.astro";
import { getEpisodes } from "../lib/podcast";

const episodes = await getEpisodes(8);
---
<SiteLayout
  title="Chile, Mole & Tech — Mariano Rentería"
  description="Podcast amateur de tecnología con foco en TI, desde México para LATAM y España. Escúchalo en Spotify, Apple Podcasts y YouTube."
>
  <section class="page-hero wrap">
    <span class="kicker">Podcast</span>
    <h1>Chile, Mole &amp; Tech</h1>
    <p>Un podcast amateur de tecnología, con un foco y cariño especial en TI. Desde México para LATAM y España, with love.</p>
  </section>

  <section class="band" style="padding-top:8px;">
    <div class="wrap">
      <PodcastPromo
        showAll
        alt="Portada de Chile, Mole & Tech"
        description="Platico, a veces solo y a veces con invitadas e invitados, de programación, liderazgo, contratación, startups, ciberseguridad y lo que se cuece en la industria. Empecé en 2020; ya van más de 170 episodios."
      />

      <div class="section-head" style="margin-top:48px;">
        <div>
          <span class="kicker">Episodios</span>
          <h2>Lo más reciente</h2>
          <p class="lede">Ocho episodios tomados del feed del podcast. El archivo completo está en Spotify y Apple Podcasts.</p>
        </div>
      </div>

      {episodes.length > 0 ? (
        <ol class="episodes">
          {episodes.map((episode) => (
            <li class="episode">
              <div>
                <div class="when">{episode.date}{episode.duration ? ` · ${episode.duration}` : ""}</div>
                <h3>{episode.title}</h3>
                {episode.summary && <p>{episode.summary}</p>}
              </div>
              <a class="listen" href={episode.link} target="_blank" rel="noopener">Escuchar →</a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="lede">No pude leer el feed en este momento. Los episodios están en Spotify y Apple Podcasts.</p>
      )}
    </div>
  </section>
</SiteLayout>
