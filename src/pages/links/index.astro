---
import LinksLayout from "../../layouts/LinksLayout.astro";
import Socials from "../../components/Socials.astro";
import PodcastPromo from "../../components/PodcastPromo.astro";
import PostCard from "../../components/PostCard.astro";
import ProductCard from "../../components/ProductCard.astro";
import Signup from "../../components/Signup.astro";
import { products } from "../../data/products";
import { linksHeroSocials } from "../../data/site";
import { getPosts } from "../../lib/posts";

const posts = (await getPosts()).slice(0, 3);
const linkProducts = products.filter((product) => product.links);
const advisory = products.find((product) => product.featured);
---
<LinksLayout
  title="Mariano Rentería — Ingeniero, podcaster y mentor"
  description="SVP of Engineering en MedTrainer, host de Chile, Mole & Tech. Mentorías, guías y un blog sobre carrera y tecnología. Desde Querétaro, para LATAM."
>
  <main id="top">
    <section class="hero wrap">
      <img class="hero-photo" src="/images/avatar-medtrainer.png" alt="Mariano Rentería, sonriendo con una camisa polo clara" width="168" height="168" />
      <h1>Mariano Rentería</h1>
      <p class="tagline">Ingeniero, podcaster y mentor</p>
      <p class="where">SVP of Engineering en MedTrainer<br />Querétaro, México</p>
      <Socials items={linksHeroSocials} label="Redes sociales" />
    </section>

    <section id="bio">
      <div class="wrap">
        <div class="bio-card">
          <span class="kicker">Bio</span>
          <h2>Ex-chilango, neo-queretano.</h2>
          <p>Soy Mariano. Llevo más de 20 años construyendo software: empecé a programar a los 12, pasé por equipos en Walmart y GE, y hoy dirijo ingeniería en MedTrainer, una empresa de health tech donde entré el día uno y ayudé a crecer el equipo a más de 90 personas.</p>
          <p>Cada semana platico de tecnología en <em>Chile, Mole &amp; Tech</em>, escribo sobre carrera y liderazgo, y acompaño a gente de tech con mentorías y guías prácticas. También soy co-organizador de AI Tinkerers Querétaro y formo parte de la comunidad PHP México.</p>
        </div>
      </div>
    </section>

    <section id="podcast" class="band alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Podcast</span>
            <h2>Chile, Mole &amp; Tech</h2>
            <p class="lede">Un podcast amateur de tecnología, con un foco y cariño especial en TI. Desde México para LATAM y España, with love.</p>
          </div>
        </div>
        <PodcastPromo
          alt="Portada de Chile, Mole & Tech: teclado de fondo y el título en recuadros morados"
          description="Platico, a veces solo y a veces con invitadas e invitados, de programación, liderazgo, contratación, startups y lo que se cuece en la industria. Ya van más de 170 episodios — un episodio nuevo casi cada semana."
        />
      </div>
    </section>

    <section id="productos" class="band">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Gumroad</span>
            <h2>Libros y asesorías</h2>
            <p class="lede">Guías prácticas y sesiones uno a uno para crecer en tech — de junior a líder, y en el CV que te abre puertas.</p>
          </div>
          <a class="text-link" href="https://marianorenteria.gumroad.com/" target="_blank" rel="noopener">Ver todo en Gumroad →</a>
        </div>
        <div class="grid-4">
          {linkProducts.map((product) => <ProductCard product={product} />)}
        </div>
        {advisory && (
          <p class="consulting">
            También ofrezco <a href={advisory.href} target="_blank" rel="noopener">Executive Advisory Consulting</a> para founders y equipos directivos, desde $250 USD.
          </p>
        )}
      </div>
    </section>

    <section id="blog" class="band alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">Blog y newsletter</span>
            <h2>Lo último que escribí</h2>
            <p class="lede">El blog y el newsletter son lo mismo: lo que publico aquí también te puede llegar por email. Estos tres posts salen de mi blog en DEV Community.</p>
          </div>
          <a class="text-link" href="/blog">Ver todos los posts →</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
        <Signup text="Una nota de vez en cuando: carrera, liderazgo y tecnología, sin spam y con permiso de darte de baja cuando quieras." />
      </div>
    </section>
  </main>
</LinksLayout>
