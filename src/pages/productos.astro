---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { everythingBundle, products } from "../data/products";
---
<SiteLayout
  title="Productos — Mariano Rentería"
  description="Mentorías, revisión de C.V., guías de bolsillo y executive advisory consulting de Mariano Rentería, en Gumroad."
>
  <section class="page-hero wrap">
    <span class="kicker">Productos</span>
    <h1>Libros y asesorías</h1>
    <p>Guías prácticas y sesiones uno a uno para crecer en tech — de junior a líder, en el C.V. que te abre puertas, o en advisory para equipos directivos. Todo está en Gumroad; los precios son en USD.</p>
  </section>

  <section class="band" style="padding-top:12px;">
    <div class="wrap">
      <div class="grid-2">
        {products.map((product) => (
          <ProductCard product={product} featured={product.featured === true} />
        ))}
      </div>
      <p style="margin:28px 0 0;color:var(--muted);text-align:center;">
        También hay un <a href={everythingBundle.href} target="_blank" rel="noopener">{everythingBundle.name}</a> en Gumroad, aunque ahora mismo no está a la venta.
      </p>
    </div>
  </section>
</SiteLayout>
