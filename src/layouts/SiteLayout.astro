---
import "../styles/site.css";
import "../styles/chrome.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { htmlLang } from "../i18n";
import { localeFromPath, type Alternate, type Locale } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  schema?: unknown;
  locale?: Locale;
  alternates?: Alternate[];
  switchHref?: string;
}
const props = Astro.props;
const locale = props.locale ?? localeFromPath(Astro.url.pathname);
---
<html lang={htmlLang(locale)}>
  <head>
    <BaseHead {...props} locale={locale} />
  </head>
  <body>
    <Header locale={locale} switchHref={props.switchHref} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
