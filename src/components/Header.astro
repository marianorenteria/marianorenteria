---
import { isCurrent, nav } from "../data/site";

interface Props {
  variant?: "site" | "links";
}
const { variant = "site" } = Astro.props;
const path = Astro.url.pathname;
---
<header>
  <div class="header-inner">
    {variant === "links" ? (
      <>
        <a class="brand" href="#top">
          <img src="/images/avatar-medtrainer.png" alt="" width="36" height="36" />
          Mariano Rentería
        </a>
        <nav aria-label="Principal">
          <a href="#bio">Bio</a>
          <a href="#podcast">Podcast</a>
          <a href="#productos">Productos</a>
          <a href="#blog">Blog</a>
        </nav>
      </>
    ) : (
      <>
        <a class="brand" href="/">
          <img src="/images/avatar-medtrainer.png" alt="" width="36" height="36" />
          Mariano Rentería
        </a>
        <nav aria-label="Principal">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(path, item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </>
    )}
  </div>
</header>
