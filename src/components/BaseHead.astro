---
import { ogLocale, useTranslations } from "../i18n";
import { localeFromPath, staticAlternates, type Alternate, type Locale } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Search canonical. Imported posts pass the original DEV URL. */
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  schema?: unknown;
  locale?: Locale;
  alternates?: Alternate[];
}

const {
  title,
  description,
  image = "/images/avatar-medtrainer.png",
  canonical,
  type = "website",
  publishedTime,
  schema,
  alternates,
} = Astro.props;

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://marianorenteria.com");
const localUrl = new URL(Astro.url.pathname, site).href;
const canonicalUrl = canonical ?? localUrl;
const imageUrl = new URL(image, site).href;
const rssPath = locale === "en" ? "/en/rss.xml" : "/rss.xml";
const rssUrl = new URL(rssPath, site).href;
const links = alternates ?? staticAlternates(Astro.url.pathname, site.href);
const jsonLd = schema ? JSON.stringify(schema).replace(/</g, "\\u003c") : "";
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{links?.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta name="theme-color" content="#f6f0e8" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={localUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={ogLocale(locale)} />
<meta property="og:locale:alternate" content={ogLocale(locale === "en" ? "es" : "en")} />
<meta property="og:site_name" content="Mariano Rentería" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="alternate" type="application/rss+xml" title={t.blog.rssTitle} href={rssUrl} />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
