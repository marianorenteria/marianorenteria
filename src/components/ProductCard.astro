---
interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  alt: string;
  price: string;
  rating: string;
  cta: string;
  featured?: boolean;
}
const { href, title, description, image, alt, price, rating, cta, featured = false } = Astro.props;
---
<a class:list={["card", { featured }]} href={href} target="_blank" rel="noopener">
  <div class="thumb">
    <img src={image} alt={alt} />
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <div class="meta">
      <span class="price">{price}</span>
      <span class="rating">{rating}</span>
    </div>
    <span class="cta">{cta}</span>
  </div>
</a>
