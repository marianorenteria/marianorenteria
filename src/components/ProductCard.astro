---
import type { Product } from "../data/products";

interface Props {
  product: Product;
  featured?: boolean;
  summary?: boolean;
}
const { product, featured = false, summary = false } = Astro.props;
---
<a class:list={["card", { featured }]} href={product.href} target="_blank" rel="noopener">
  <div class="thumb">
    <img src={product.image} alt={product.alt} />
  </div>
  <div class="body">
    <h3>{product.title}</h3>
    <p class="desc">{summary ? product.summary : product.description}</p>
    <div class="meta">
      <span class="price">{product.price}</span>
      <span class="rating">{product.rating}</span>
    </div>
    <span class="cta">Ver en Gumroad →</span>
  </div>
</a>
