---
import { formatDate } from "../lib/dates";
import type { Locale } from "../i18n/routes";

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description: string;
  date: Date;
  minutes: number;
  cover: string;
  cta: string;
  minutesLabel: string;
  note?: string;
}
const { locale, href, title, description, date, minutes, cover, cta, minutesLabel, note } = Astro.props;
---
<a class="card" href={href}>
  <div class="thumb post">
    <img src={cover} alt="" />
  </div>
  <div class="body">
    <p class="post-meta">{formatDate(date, locale)} · {minutes} {minutesLabel}{note ? ` ${note}` : ""}</p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <span class="cta">{cta}</span>
  </div>
</a>
