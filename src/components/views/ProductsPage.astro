---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductCard from "../ProductCard.astro";
import { productCopy, useTranslations } from "../../i18n";
import { localeFromPath, type Locale } from "../../i18n/routes";
import { everythingBundle, products } from "../../data/products";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<SiteLayout locale={locale} title={t.products.title} description={t.products.description}>
  <section class="page-hero wrap">
    <span class="kicker">{t.products.kicker}</span>
    <h1>{t.products.heading}</h1>
    <p>{t.products.lede}</p>
  </section>

  <section class="band" style="padding-top:12px;">
    <div class="wrap">
      <div class="grid-2">
        {products.map((product) => {
          const copy = productCopy(locale, product);
          return (
            <ProductCard
              href={product.href}
              title={copy.title}
              description={copy.description}
              image={product.image}
              alt={copy.alt}
              price={copy.price}
              rating={copy.rating}
              cta={t.products.cta}
              featured={product.featured === true}
            />
          );
        })}
      </div>
      <p style="margin:28px 0 0;color:var(--muted);text-align:center;">
        {t.products.bundleBefore} <a href={everythingBundle.href} target="_blank" rel="noopener">{everythingBundle.name}</a> {t.products.bundleAfter}
      </p>
    </div>
  </section>
</SiteLayout>
