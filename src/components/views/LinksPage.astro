---
import LinksLayout from "../../layouts/LinksLayout.astro";
import Socials from "../Socials.astro";
import PodcastPromo from "../PodcastPromo.astro";
import PostCard from "../PostCard.astro";
import ProductCard from "../ProductCard.astro";
import Signup from "../Signup.astro";
import { productCopy, useTranslations } from "../../i18n";
import { localeFromPath, routes, type Locale } from "../../i18n/routes";
import { products } from "../../data/products";
import { linksHeroSocials } from "../../data/site";
import { getBlogList } from "../../lib/posts";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const posts = (await getBlogList(locale)).slice(0, 3);
const linkProducts = products.filter((product) => product.links);
const advisory = products.find((product) => product.featured);
const socials = linksHeroSocials.map((item) => (item.icon === "dev" ? { ...item, label: t.devLabel } : item));
---
<LinksLayout locale={locale} title={t.links.title} description={t.links.description}>
  <main id="top">
    <section class="hero wrap">
      <img class="hero-photo" src="/images/avatar-medtrainer.png" alt={t.home.heroAlt} width="168" height="168" />
      <h1>Mariano Rentería</h1>
      <p class="tagline">{t.links.tagline}</p>
      <p class="where">{t.links.role}<br />{t.links.place}</p>
      <Socials items={socials} label={t.socialsLabel} />
    </section>

    <section id="bio">
      <div class="wrap">
        <div class="bio-card">
          <span class="kicker">{t.links.bioKicker}</span>
          <h2>{t.links.bioHeading}</h2>
          <p>{t.links.bioFirst}</p>
          <p>{t.links.bioSecondBefore} <em>Chile, Mole &amp; Tech</em>{t.links.bioSecondAfter}</p>
        </div>
      </div>
    </section>

    <section id="podcast" class="band alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">{t.podcast.kicker}</span>
            <h2>Chile, Mole &amp; Tech</h2>
            <p class="lede">{t.home.podcastLede}</p>
          </div>
        </div>
        <PodcastPromo locale={locale} alt={t.podcast.linksCoverAlt} description={t.home.podcastBlurb} />
      </div>
    </section>

    <section id="productos" class="band">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">{t.home.productsKicker}</span>
            <h2>{t.home.productsHeading}</h2>
            <p class="lede">{t.products.linksLede}</p>
          </div>
          <a class="text-link" href="https://marianorenteria.gumroad.com/" target="_blank" rel="noopener">{t.products.all}</a>
        </div>
        <div class="grid-4">
          {linkProducts.map((product) => {
            const copy = productCopy(locale, product);
            return (
              <ProductCard
                href={product.href}
                title={copy.title}
                description={copy.description}
                image={product.image}
                alt={copy.alt}
                price={copy.price}
                rating={copy.rating}
                cta={t.products.cta}
              />
            );
          })}
        </div>
        {advisory && (
          <p class="consulting">
            {t.products.consultingBefore} <a href={advisory.href} target="_blank" rel="noopener">{advisory.title}</a> {t.products.consultingAfter}
          </p>
        )}
      </div>
    </section>

    <section id="blog" class="band alt">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker">{t.home.blogKicker}</span>
            <h2>{t.home.blogHeading}</h2>
            <p class="lede">{t.links.blogLede}</p>
          </div>
          <a class="text-link" href={routes[locale].blog}>{t.home.allPosts}</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => (
            <PostCard
              locale={locale}
              href={post.href}
              title={post.title}
              description={post.description}
              date={post.date}
              minutes={post.minutes}
              cover={post.cover}
              cta={t.blog.read}
              minutesLabel={t.blog.minutes}
              note={post.untranslated ? t.blog.otherLanguageNote : undefined}
            />
          ))}
        </div>
        <Signup locale={locale} text={t.signup.linksText} />
      </div>
    </section>
  </main>
</LinksLayout>
