---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { useTranslations } from "../../i18n";
import { routes, type Locale } from "../../i18n/routes";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<SiteLayout locale={locale} title={t.notFound.title} description={t.notFound.description}>
  <section class="page-hero wrap">
    <span class="kicker">{t.notFound.kicker}</span>
    <h1>{t.notFound.heading}</h1>
    <p>{t.notFound.lede}</p>
    <div class="ctas" style="margin-top:24px;">
      <a class="btn" href={routes[locale].home}>{t.notFound.home}</a>
      <a class="btn ghost" href={routes[locale].blog}>{t.notFound.blog}</a>
    </div>
  </section>
</SiteLayout>
